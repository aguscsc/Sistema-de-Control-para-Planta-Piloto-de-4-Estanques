% =========================================================================
% Parámetros de la Planta de 4 Estanques (Sistema Internacional)
% Hardware: Danfoss VLT 2800 + Bomba Shertec Hypro (1 HP)
% =========================================================================

% 1. Constante de Gravedad
g = 9.81; % [m/s^2]

% 2. Áreas transversales de los estanques (Ai)
% Estimación para estanques cilíndricos de laboratorio
A1 = 0.172; A2 = 0.172; A3 = 0.172; A4 = 0.172; % [m^2]

% 3. Áreas de las válvulas de descarga/fugas (ai)
a1 = 0.00015; a2 = 0.00015; a; a4 = 0.00015; % [m^2]

% 4. Posición de las válvulas de 3 vías (Gamma)
gamma1 = 0.6; % 60% del flujo de Bomba 1 va al Estanque 1, 40% al Estanque 4
gamma2 = 0.6; % 60% del flujo de Bomba 2 va al Estanque 2, 40% al Estanque 3

% =========================================================================
% 5. PARÁMETROS DEL ACTUADOR Y CÁLCULO DE GANANCIA (k)
% =========================================================================

% Límites del Variador de Frecuencia (VLT 2800)
freq_max = 50; % [Hz] Límite superior de red
freq_min = 15; % [Hz] Zona muerta estimada para vencer la carga estática

% Desempeño Nominal Estimado de la Bomba Shertec Hypro
% Caudal máximo estimado operando a freq_max
q_max_L_min = 300; % [L/min] 

% Conversión de Caudal al Sistema Internacional [m^3/s]
% 1 m^3 = 1000 L  |  1 min = 60 s
q_max_SI = q_max_L_min / (1000 * 60); % [m^3/s]

% Cálculo final de la ganancia (k = Caudal Máximo / Frecuencia Máxima)
k1 = q_max_SI / freq_max; % [m^3/s por cada Hz]
k2 = q_max_SI / freq_max; % [m^3/s por cada Hz]