		ST_ROUTINE LIMITES 
			'// F = asqrt(2qh)
			'// M = [k1*y1, -k2*(y2 - 1)]
			'//     [-k1*(y1 - 1),        k2*y2]
			'// M^-1 [ y2/(k1*y1 - k1 + k1*y2), (y2 - 1)/(k1*y1 - k1 + k1*y2)]
			'//      [(y1 - 1)/(k2*y1 - k2 + k2*y2),       y1/(k2*y1 - k2 + k2*y2)]
			'
			'// ==========================================================================
			'// 1. CÁLCULO DE FLUJOS REQUERIDOS (P1 y P2) BASADOS EN SETPOINTS (SP_L1, SP_L2)
			'// ==========================================================================
			'P1 := a1 * SQRT(2.0 * 9.81 * SP_L1*0.6/100);
			'P2 := a2 * SQRT(2.0 * 9.81 * SP_L2*0.6/100);
			'
			'// ==========================================================================
			'// 2. ESFUERZO INSTANTÁNEO DEMANDADO A LAS BOMBAS
			'// ==========================================================================
			'// ERROR CORREGIDO: Se utilizan P1 y P2 en lugar de SP_F1 y SP_L2
			'u1_Req := (I11 * P1) + (I12 * P2);
			'u2_Req := (I21 * P1) + (I22 * P2);
			'
			'// Limpieza numérica de ruido digital cerca de cero absoluto
			'IF ABS(u1_Req) < 0.001 THEN u1_Req := 0.0; END_IF;
			'IF ABS(u2_Req) < 0.001 THEN u2_Req := 0.0; END_IF;
			'
			'// ==========================================================================
			'// 3. OBTENCIÓN DE LÍMITES REALES DE FLUJO (DESENROLLADO DE PYTHON)
			'// ==========================================================================
			'// Inicializamos las variables de búsqueda a extremos absolutos
			'F1_Min_Allowed := 0.0;
			'F1_Max_Allowed := 999999.0;
			'F2_Min_Allowed := 0.0;
			'F2_Max_Allowed := 999999.0;
			'
			'// -----------------------------------------------------------
			'// A) LÍMITES PARA ESTANQUE 1 (F1) DADO EL FLUJO DEL ESTANQUE 2 (P2)
			'// -----------------------------------------------------------
			'// Evaluamos los cortes con U_MIN y U_MAX respecto a la Bomba 1
			'Val_u1_min_F1 := (U_MIN - (I12 * P2)) / I11;
			'Val_u1_max_F1 := (U_MAX - (I12 * P2)) / I11;
			'
			'// Corrección de desigualdad según el signo de la Matriz Inversa (I11)
			'IF I11 > 0.0 THEN
			'    IF Val_u1_min_F1 > F1_Min_Allowed THEN F1_Min_Allowed := Val_u1_min_F1; END_IF;
			'    IF Val_u1_max_F1 < F1_Max_Allowed THEN F1_Max_Allowed := Val_u1_max_F1; END_IF;
			'ELSE
			'    IF Val_u1_min_F1 < F1_Max_Allowed THEN F1_Max_Allowed := Val_u1_min_F1; END_IF;
			'    IF Val_u1_max_F1 > F1_Min_Allowed THEN F1_Min_Allowed := Val_u1_max_F1; END_IF;
			'END_IF;
			'
			'// Evaluamos los cortes con U_MIN y U_MAX respecto a la Bomba 2
			'Val_u2_min_F1 := (U_MIN - (I22 * P2)) / I21;
			'Val_u2_max_F1 := (U_MAX - (I22 * P2)) / I21;
			'
			'// Corrección de desigualdad según el signo de la Matriz Inversa (I21)
			'IF I21 > 0.0 THEN
			'    IF Val_u2_min_F1 > F1_Min_Allowed THEN F1_Min_Allowed := Val_u2_min_F1; END_IF;
			'    IF Val_u2_max_F1 < F1_Max_Allowed THEN F1_Max_Allowed := Val_u2_max_F1; END_IF;
			'ELSE
			'    IF Val_u2_min_F1 < F1_Max_Allowed THEN F1_Max_Allowed := Val_u2_min_F1; END_IF;
			'    IF Val_u2_max_F1 > F1_Min_Allowed THEN F1_Min_Allowed := Val_u2_max_F1; END_IF;
			'END_IF;
			'
			'
			'// -----------------------------------------------------------
			'// B) LÍMITES PARA ESTANQUE 2 (F2) DADO EL FLUJO DEL ESTANQUE 1 (P1)
			'// -----------------------------------------------------------
			'// Evaluamos los cortes con U_MIN y U_MAX respecto a la Bomba 1
			'Val_u1_min_F2 := (U_MIN - (I11 * P1)) / I12;
			'Val_u1_max_F2 := (U_MAX - (I11 * P1)) / I12;
			'
			'IF I12 > 0.0 THEN
			'    IF Val_u1_min_F2 > F2_Min_Allowed THEN F2_Min_Allowed := Val_u1_min_F2; END_IF;
			'    IF Val_u1_max_F2 < F2_Max_Allowed THEN F2_Max_Allowed := Val_u1_max_F2; END_IF;
			'ELSE
			'    IF Val_u1_min_F2 < F2_Max_Allowed THEN F2_Max_Allowed := Val_u1_min_F2; END_IF;
			'    IF Val_u1_max_F2 > F2_Min_Allowed THEN F2_Min_Allowed := Val_u1_max_F2; END_IF;
			'END_IF;
			'
			'// Evaluamos los cortes con U_MIN y U_MAX respecto a la Bomba 2
			'Val_u2_min_F2 := (U_MIN - (I21 * P1)) / I22;
			'Val_u2_max_F2 := (U_MAX - (I21 * P1)) / I22;
			'
			'IF I22 > 0.0 THEN
			'    IF Val_u2_min_F2 > F2_Min_Allowed THEN F2_Min_Allowed := Val_u2_min_F2; END_IF;
			'    IF Val_u2_max_F2 < F2_Max_Allowed THEN F2_Max_Allowed := Val_u2_max_F2; END_IF;
			'ELSE
			'    IF Val_u2_min_F2 < F2_Max_Allowed THEN F2_Max_Allowed := Val_u2_min_F2; END_IF;
			'    IF Val_u2_max_F2 > F2_Min_Allowed THEN F2_Min_Allowed := Val_u2_max_F2; END_IF;
			'END_IF;
			'
			'
			'// ==========================================================================
			'// 4. CONVERSIÓN DE FLUJOS A LÍMITES DE ALTURA FÍSICA EN METROS (Torricelli)
			'// ==========================================================================
			'
			'// Para el Estanque 1 (h1)
			'IF (F1_Max_Allowed >= F1_Min_Allowed) AND (F1_Min_Allowed >= 0.0) THEN
			'    h1_Min_Limit := (100/h_max)*(F1_Min_Allowed * F1_Min_Allowed) / (2.0 * 9.81 * a1 * a1);
			'ELSE
			'    h1_Min_Limit := 0.0;
			'END_IF;
			'
			'IF (F1_Max_Allowed >= F1_Min_Allowed) AND (F1_Max_Allowed > 0.0) THEN
			'    h1_Max_Limit := (100/h_max)*(F1_Max_Allowed * F1_Max_Allowed) / (2.0 * 9.81 * a1 * a1);
			'ELSE
			'    h1_Max_Limit := -1.0; // Estado inalcanzable
			'END_IF;
			'
			'// Para el Estanque 2 (h2)
			'IF (F2_Max_Allowed >= F2_Min_Allowed) AND (F2_Min_Allowed >= 0.0) THEN
			'    h2_Min_Limit := (100/h_max)*(F2_Min_Allowed * F2_Min_Allowed) / (2.0 * 9.81 * a2 * a2);
			'ELSE
			'    h2_Min_Limit := 0.0;
			'END_IF;
			'
			'IF (F2_Max_Allowed >= F2_Min_Allowed) AND (F2_Max_Allowed > 0.0) THEN
			'    h2_Max_Limit := (100/h_max)*(F2_Max_Allowed * F2_Max_Allowed) / (2.0 * 9.81 * a2 * a2);
			'ELSE
			'    h2_Max_Limit := -1.0; // Estado inalcanzable
			'END_IF;
		END_ST_ROUTINE

		ROUTINE MainRoutine 
				N: XIC(S:FS)JSR(parametros,0);
				N: XIC(parada)JSR(Parada_de_emergencia,0);
				N: XIC(inicio)JSR(Inicio_planta,0);
				N: MUL(Tp_l3,1000,prbs_timer_L3.PRE)MUL(Tp_l4,1000,prbs_timer_L4.PRE);
				N: XIC(Sw_am_L4)XIC(prbs_L4_on)TON(prbs_timer_L4,?,?)XIO(prbs_timer_L4.DN)JSR(prbs_L4,0);
				N: [XIO(prbs_L4_on) ,XIC(prbs_timer_L4.DN) ]JSR(PRBS_L4_reset,0);
				N: JSR(LIC_01,0);
				N: XIC(Sw_am_L3)XIC(prbs_L3_on)TON(prbs_timer_L3,?,?)XIO(prbs_timer_L3.DN)JSR(prbs_L3,0);
				N: [XIO(prbs_L3_on) ,XIC(prbs_timer_L3.DN) ]JSR(PRBS_L3_reset,0);
				N: JSR(LIC_02,0);
				N: JSR(LIMITES,0);
				N: JSR(estimador_L3,0);
				N: JSR(LIC_03,0);
				N: JSR(estimador_L4,0);
				N: JSR(LIC_04,0);
				N: JSR(selector_1,0);
				N: JSR(selector_2,0);
				N: MUL(Tp1,1000,prbs_timer_F1.PRE)MUL(Tp2,1000,prbs_timer_F2.PRE);
				N: XIC(Sw_am_F1)XIC(prbs_F1_on)TON(prbs_timer_F1,?,?)XIO(prbs_timer_F1.DN)JSR(PRBS_1,0);
				N: [XIO(prbs_F1_on) ,XIC(prbs_timer_F1.DN) ]JSR(pr1_reset,0);
				N: JSR(estimador_F1,0);
				N: JSR(FIC_01,0);
				N: XIC(Sw_am_F2)XIC(prbs_F2_on)TON(prbs_timer_F2,?,?)XIO(prbs_timer_F2.DN)JSR(PRBS_2,0);
				N: [XIO(prbs_F2_on) ,XIC(prbs_timer_F2.DN) ]JSR(pr2_reset,0);
				N: JSR(estimador_F2,0);
				N: JSR(FIC_02,0);
				N: SSV(Task,ControlProgram,Rate,t_task);
				N: GSV(Task,ControlProgram,LastScanTime,Scan_Actual_us);
				N: GSV(Task,ControlProgram,MaxScanTime,Scan_Max_us);
				N: JSR(scantime,0);
		END_ROUTINE

