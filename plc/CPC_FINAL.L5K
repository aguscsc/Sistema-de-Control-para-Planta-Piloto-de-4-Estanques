			NC_LIT_04 : BOOL (Description := "LIT04 no conectado",
			            RADIX := Decimal) := 0;
		END_TAG

		ST_ROUTINE Alarmas 
			'//desconexion de FIT
			'if (FIT_01 <= -3.626)then
			'	NC_FIT_01 :=1;
			'	parada := 1;
			'elsif (FIT_02 <= -3.626) then
			'	NC_FIT_02 :=1;
			'	parada := 1;
			'end_if;
			'
			'// reconexion de FIT
			'if (FIT_01 > -3.626)then
			'	NC_FIT_01 :=0;
			'elsif (FIT_02 > -3.626) then
			'	NC_FIT_02 :=0;
			'end_if;
			'
			'//desconexion de FIT
			'if (LIT_01 <= -3.626)then
			'	NC_LIT_01 :=1;
			'	parada := 1;
			'elsif (LIT_02 <= -3.626) then
			'	NC_LIT_02 :=1;
			'	parada := 1;
			'end_if;
			'
			'// reconexion de FIT
			'if (LIT_01 > -3.626)then
			'	NC_LIT_01 :=0;
			'elsif (LIT_02 > -3.626) then
			'	NC_LIT_02 :=0;
			'end_if;
			'
			'// enable PRBS 1
			'//if VF01 <= (pmax_1+1) and VF01 >= (pmin_1-1) then
			'//	prbs_enable_1 := 1;
			'//else
			'//	prbs_enable_1 := 0;
			'//	prbs_1_on :=0;
			'//end_if;
			'
			'// enable PRBS 2
			'//if VF02 <= (pmax_2+1) and VF02 >= (pmin_2-1) then
			'//	prbs_enable_2 := 1;
			'//else
			'//	prbs_enable_2 := 0;
			'//	prbs_2_on :=0;
			'//end_if;
			'	
			'	
			'
		END_ST_ROUTINE

		ROUTINE ContinuousRoutine 
				N: JSR(Alarmas,0);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

