		ST_ROUTINE parametros 
			'// Condiciones iniciales
			'SP_L1 := 0;
			'SP_L2 := 0;
			'SP_L4 := 0;
			'SP_L4 := 0;
			'SP_F1 := 0;
			'SP_F2 := 0;
			'inicio :=0;
			'dumax_F1 := 1;
			'dumax_F2 := 1;
			'dumax_L1 := 1;
			'dumax_L2 := 1;
			'umax_F1 := 95;
			'umin_F1 := 0;
			'umax_F2 := 95;
			'umin_F2 := 0;
			'umax_L1 := 100;
			'umin_L1 := 0;
			'umax_L2 := 100;
			'umin_L2 := 0;
			'dumax_L3 :=1;
			'umax_L3 :=100;
			'umin_L3 :=0;
			'dumax_L4 :=1;
			'umax_L4 :=100;
			'umin_L4 :=0;
			'Nb_F1 :=0;
			'Nb_F2 :=0;
			'Sw_acc_b1 :=0;
			'sw_acc_b2 :=0;
			'kff_1 :=0.75;
			'kw_1 :=0.75;
			'kff_2 :=1;
			'kw_2:=1;
			'kff_3 :=0.75;
			'kff_4 :=1;
			'prbs_enable_F1 :=0;
			'// Constantes físicas del sistema
			'g := 9.81;
			'a1 := 6.1360 / 10000; 
			'a2 := 5.4678 / 10000;
			'a3 := 3.5752 / 10000;
			'a4 := 4.1820 / 10000;
			'k1 :=0.0017;
			'k2 := 0.0017;
			'gamma1 := 0.455; 
			'gamma2 := 0.4195;
			'Tm := 0.1;    
			't_task := Tm*1000000;
			'h_max := 0.6; //altura del estanque
			'q_max := 0.0017;
			'I11 := (gamma2/(k1*gamma1 - k1 + k1*gamma2));
			'I12 := ((gamma2 - 1)/(k1*gamma1 - k1 + k1*gamma2));
			'I21 := (gamma1 - 1)/(k2*gamma1 - k2 + k2*gamma2);
			'I22 := (gamma1/(k2*gamma1 - k2 + k2*gamma2));
			'U_MAX := 1.0;
			'U_MIN := 0.26;
			'// switches auto / man
			'Sw_am_F1 :=1;
			'Sw_am_F2 :=1;
			'Sw_am_L1 :=1;
			'Sw_am_L2 :=1;
			'Sw_am_L3 :=1;
			'Sw_am_L4 :=1;
			'Sw_local_F1 :=0;
			'Sw_local_F2 :=0;
			'Sel1 :=1;
			'Sel2 :=1;
			'bypass_1 :=0;
			'bypass_2 :=0;
			'bypass_3 :=0;
			'bypass_4 :=0;
			'Sw_acc_b1 :=0;
			'sw_acc_b2 :=0;
			'// switches ff
			'Sw_FF_1 :=1;
			'Sw_FF_2 :=1;
			'// setpoint tracking
			'Sw_SP_track_L1:=1;
			'Sw_SP_track_L2:=1;
			'Sw_SP_track_L3:=1;
			'Sw_SP_track_L4:=1;
			'Sw_SP_track_F1:=1;
			'Sw_SP_track_F2:=1;
			'// bomba inicial
			'CV_F1 :=0;
			'CV_F1_prev :=0;
			'CV_F2 :=0;
			'CV_F2_Prev :=0;
			'CV_F1_man :=0;
			'CV_F2_man :=0;
			'CV_F1_Real :=0;
			'CV_F2_Real :=0;
			'// ============== PID ==============
			'// LIC01
			'Kc_L1 :=5;
			'Ki_L1 :=0.026;
			'Kd_L1 :=0;
			'//LIC02
			'Kc_L2 :=5;
			'Ki_L2 :=0.03;
			'Kd_L2 :=0.0;
			'//LIC03
			'Kc_L3 :=6.8;
			'Ki_L3 :=0.0222;
			'Kd_L3 :=0;
			'//LIC04
			'Kc_L4 :=6.5;
			'Ki_L4 :=0.022;
			'Kd_L4 :=0;
			'// FIC01
			'Kc_F1 :=1.45;
			'Ki_F1 :=0.75;
			'Kd_F1 :=0.0;
			'//FIC02
			'Kc_F2 :=1.6;
			'Ki_F2 :=0.75;
			'Kd_F2 :=0;
			'//PRBS
			'//seeds
			'sh.1 := 0;
			'sh.2 := 0;
			'sh.3 := 1;
