	PROGRAM ContinuousProgram (MAIN := "ContinuousRoutine",
	                           MODE := 0,
	                           DisableFlag := 0,
	                           UseAsFolder := 0)
		TAG
			NC_FIT_01 : BOOL (Description := "FIT 01 desconectado",
			            RADIX := Decimal) := 0;
			NC_FIT_02 : BOOL (Description := "FIT 02 no conectado",
