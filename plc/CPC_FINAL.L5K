		ST_ROUTINE estimador_F1 
			'// =============================================================================
			'// ESTIMADOR RLS-HOREXT (LAZO F1) -- VERSION 3 (CORREGIDA)
			'// Sincronizado con Divisor de Scans Directo (input_scans_F1)
			'// =============================================================================
			'
			'// 1. Validar el input del usuario (Tag desde el HMI) compartido con el Controlador
			'IF input_scans_F1 < 1 THEN
			'    input_scans_F1 := 1;
			'END_IF;
			'
			'// 2. Incrementar el contador de barridos exclusivo del estimador
			'Contador_Scans_F1 := Contador_Scans_F1 + 1;
			'
			'// 3. Evaluar si es el scan correspondiente para ejecutar el RLS
			'IF Contador_Scans_F1 >= input_scans_F1 THEN
			'
			'    // Resetear el contador
			'    Contador_Scans_F1 := 0;
			'
			'    // ========================= RESET =========================================
			'    IF estimador_F1_reset THEN
			'        FOR i := 0 TO 15 DO
			'            theta_F1[i]   := 0.0;
			'            phi_F1[i]     := 0.0;
			'            K_Gain_F1[i]  := 0.0;
			'            P_Phi_F1[i]   := 0.0;
			'            dy_hist_F1[i] := 0.0;
			'            du_hist_F1[i] := 0.0;
			'
			'            FOR j := 0 TO 15 DO
			'                IF i = j THEN
			'                    P_matrix_F1[i,j] := 10000.0;
			'                ELSE
			'                    P_matrix_F1[i,j] := 0.0;
			'                END_IF;
			'            END_FOR;
			'        END_FOR;
			'
			'        FIT_01_Prev        := FIT_01;
			'        estimador_F1_reset := 0;
			'    END_IF;
			'
			'
			'    // ========================= DIMENSIONES ===================================
			'    // Lado A: n parametros (a0..a(n-1))
			'    // Lado B: n + T - 1 parametros (b1..b(n+T-1))
			'    // Total : 2n + T - 1
			'    n_beta_F1           := orden_F1 + horizonte_F1 - 1;
			'    limite_estimador_F1 := (2 * orden_F1) + horizonte_F1 - 2;
			'
			'
			'    // ========================= LEER SENSOR ===================================
			'    dy_F1       := FIT_01 - FIT_01_Prev;
			'    FIT_01_Prev := FIT_01;
			'
			'
			'    // =========================================================================
			'    // CONSTRUIR REGRESOR phi_k
			'    // Layout n=1, T=3:
			'    //   indice:    0          1          2          3
			'    //   contenido: -dy_{k-1}  du_{k-1}   du_{k-2}   du_{k-3}
			'    //              |--A (n)--| |------- B (n+T-1) -------|
			'    //
			'    // IMPORTANTE: cada slot B es un control pasado DISTINTO del historial,
			'    // no el mismo du repetido. Esto elimina la colinealidad.
			'
			'    // Lado A: salidas pasadas con signo negativo
			'    FOR i := 0 TO (orden_F1 - 1) DO
			'        phi_F1[i] := -dy_hist_F1[i];        // -dy_{k-1-i}
			'    END_FOR;
			'
			'    // Lado B: controles pasados reales en offsets crecientes
			'    FOR i := 0 TO (n_beta_F1 - 1) DO
			'        phi_F1[orden_F1 + i] := du_hist_F1[i];   // du_{k-1-i}
			'    END_FOR;
			'
			'
			'    // ========================= ESTIMACION Y ERROR ============================
			'    // dy_k estimado = phi' . theta  (prediccion a partir del historial)
			'    estimacion_F1 := 0.0;
			'    FOR i := 0 TO limite_estimador_F1 DO
			'        estimacion_F1 := estimacion_F1 + (phi_F1[i] * theta_F1[i]);
			'    END_FOR;
			'
			'    Error_Pred_F1 := dy_F1 - estimacion_F1;
			'    pv_est_F1 := (FIT_01 - dy_F1) + estimacion_F1;
			'
			'
			'    // ========================= P . phi =======================================
			'    FOR i := 0 TO limite_estimador_F1 DO
			'        P_Phi_F1[i] := 0.0;
			'        FOR j := 0 TO limite_estimador_F1 DO
			'            P_Phi_F1[i] := P_Phi_F1[i] + (P_matrix_F1[i,j] * phi_F1[j]);
			'        END_FOR;
			'    END_FOR;
			'
			'
			'    // ========================= FACTOR DE OLVIDO VARIABLE =====================
			'    Lambda_dem := 1.0;
			'    FOR i := 0 TO limite_estimador_F1 DO
			'        Lambda_dem := Lambda_dem + (phi_F1[i] * P_Phi_F1[i]);
			'    END_FOR;
			'
			'    IF Lambda_dem > 0.000001 AND Sigma_F1 > 0.000001 THEN
			'        Lambda_F1 := 1.0 - ((Error_Pred_F1 * Error_Pred_F1) / (Lambda_dem * Sigma_F1));
			'
			'        IF Lambda_F1 < 0.95 THEN
			'            Lambda_F1 := 0.95;
			'        ELSIF Lambda_F1 > 1.0 THEN
			'            Lambda_F1 := 1.0;
			'        END_IF;
			'    ELSE
			'        Lambda_F1 := 1.0;
			'    END_IF;
			'
			'
			'    // ========================= GANANCIA DE KALMAN ============================
			'    Denom_K_F1 := Lambda_F1;
			'    FOR i := 0 TO limite_estimador_F1 DO
			'        Denom_K_F1 := Denom_K_F1 + (phi_F1[i] * P_Phi_F1[i]);
			'    END_FOR;
			'
			'    IF Denom_K_F1 > 0.000001 THEN
			'
			'        FOR i := 0 TO limite_estimador_F1 DO
			'            K_Gain_F1[i] := P_Phi_F1[i] / Denom_K_F1;
			'        END_FOR;
			'
			'        // ----- Actualizar Parametros -----
			'        FOR i := 0 TO limite_estimador_F1 DO
			'            theta_F1[i] := theta_F1[i] + (K_Gain_F1[i] * Error_Pred_F1);
			'        END_FOR;
			'
			'        // ----- Actualizar Covarianza -----
			'        FOR i := 0 TO limite_estimador_F1 DO
			'            FOR j := 0 TO limite_estimador_F1 DO
			'                P_matrix_F1[i,j] := (P_matrix_F1[i,j] - (K_Gain_F1[i] * P_Phi_F1[j])) / Lambda_F1;
			'            END_FOR;
			'        END_FOR;
			'
			'    ELSE
			'        estimador_F1_reset := 1;
			'    END_IF;
			'
			'
			'    // =========================================================================
			'    // ACTUALIZAR HISTORIALES
			'    //dy_{k} y du_{k} disponibles como dy_{k-1}, du_{k-1}.
			'    FOR i := 9 TO 1 BY -1 DO
			'        dy_hist_F1[i] := dy_hist_F1[i - 1];
			'    END_FOR;
			'    dy_hist_F1[0] := dy_F1;
			'
			'    FOR i := 9 TO 1 BY -1 DO
			'        du_hist_F1[i] := du_hist_F1[i - 1];
			'    END_FOR;
			'    du_hist_F1[0] := du_F1;
			'
			'
			'    // =========================================================================
			'    // DIAGNOSTICO (HMI)
			'    // =========================================================================
			'    Traza_P_F1 := 0.0;
			'    FOR i := 0 TO limite_estimador_F1 DO
			'        Traza_P_F1 := Traza_P_F1 + P_matrix_F1[i,i];
			'    END_FOR;
			'
			'    a0_F1 := -theta_F1[0];
			'    a1_F1 := 0.0;
			'    a2_F1 := 0.0;
			'    b1_F1 := 0.0;
			'    b2_F1 := 0.0;
			'    b3_F1 := 0.0;
			'    b4_F1 := 0.0;
			'    b5_F1 := 0.0;
			'
			'    IF orden_F1 >= 2 THEN a1_F1 := -theta_F1[1]; END_IF;
			'    IF orden_F1 >= 3 THEN a2_F1 := -theta_F1[2]; END_IF;
			'
			'    IF n_beta_F1 >= 1 THEN b1_F1 := theta_F1[orden_F1];     END_IF;
			'    IF n_beta_F1>= 2 THEN b2_F1 := theta_F1[orden_F1 + 1]; END_IF;
			'    IF n_beta_F1 >= 3 THEN b3_F1 := theta_F1[orden_F1 + 2]; END_IF;
			'    IF n_beta_F1 >= 4 THEN b4_F1 := theta_F1[orden_F1 + 3]; END_IF;
			'    IF n_beta_F1 >= 5 THEN b5_F1 := theta_F1[orden_F1 + 4]; END_IF;
			'
			'END_IF; // Fin de la condición de scans
		END_ST_ROUTINE

		ST_ROUTINE estimador_F2 
			'// =============================================================================
			'// ESTIMADOR RLS-HOREXT (LAZO F2) -- VERSION 3 (CORREGIDA)
			'// Sincronizado con Divisor de Scans Directo (input_scans_F2)
			'// =============================================================================
			'
